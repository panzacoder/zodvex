---
/**
 * Syntax-highlighted code panel with a file-name header and per-line marks.
 * Code panels are always dark (like the command rows on convex.dev), whatever
 * section they sit in, so a single Shiki theme is enough.
 */
import { Code } from 'astro:components'
import type { ShikiTransformer } from 'shiki'
import type { Mark } from '../data/scenarios'

interface Props {
  code: string
  file?: string
  lang?: 'ts' | 'tsx' | 'bash' | 'json'
  marks?: Record<number, Mark>
}

const { code, file, lang = 'ts', marks = {} } = Astro.props

const markLines: ShikiTransformer = {
  name: 'zodvex:marks',
  line(node, line) {
    const kind = marks[line]
    if (!kind) return
    const existing = node.properties.class
    const classes = Array.isArray(existing) ? existing : existing ? [String(existing)] : []
    node.properties.class = [...classes, 'hl', `hl-${kind}`].join(' ')
  },
}
---

<figure class="codeblock">
  {file && (
    <figcaption class="codeblock-head">
      <span class="file">{file}</span>
    </figcaption>
  )}
  <Code code={code} lang={lang} theme="github-dark-dimmed" transformers={[markLines]} />
</figure>

<style>
  .codeblock {
    margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    background: var(--code-bg);
    overflow: hidden;
    min-width: 0;
    box-shadow: 0 2px 11px rgba(0, 0, 0, 0.18);
  }
  .codeblock-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font: 500 0.74rem/1 var(--font-mono);
    color: var(--n6);
    background: var(--code-head-bg);
  }
  .file::before {
    content: '';
    display: inline-block;
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--yellow);
    margin-right: 0.6rem;
    vertical-align: 1px;
  }
</style>
