---
import Base from '../layouts/Base.astro'
import CodeBlock from '../components/CodeBlock.astro'
import Compare from '../components/Compare.astro'
import { scenarios } from '../data/scenarios'

const GITHUB = 'https://github.com/panzacoder/zodvex'
const NPM = 'https://www.npmjs.com/package/zodvex'
const guide = (slug: string) => `${GITHUB}/blob/main/docs/guide/${slug}.md`

const title = 'zodvex — Zod v4 as your schema language for Convex'
const description =
  'Define tables, function arguments and return types once as Zod schemas and use them end to end in Convex — validated at every boundary, with Dates, typed IDs and custom codecs that survive the trip from the database to React.'

type Level = 'none' | 'shape' | 'zod' | 'codec'
interface Cell { level: Level; text: string }
interface Row { boundary: string; convex: Cell; helpers: Cell; zodvex: Cell }

const boundaryRows: Row[] = [
  {
    boundary: 'Client call',
    convex: { level: 'shape', text: 'Types inferred; values are wire values' },
    helpers: { level: 'shape', text: 'Same as Convex' },
    zodvex: { level: 'codec', text: 'useZodQuery validates and encodes args, decodes results' },
  },
  {
    boundary: 'Function args',
    convex: { level: 'shape', text: 'Structural check (v.*)' },
    helpers: { level: 'zod', text: 'Full Zod pipeline' },
    zodvex: { level: 'codec', text: 'Full Zod pipeline + codec decode' },
  },
  {
    boundary: 'Inside the handler',
    convex: { level: 'shape', text: 'Wire types: numbers, plain strings' },
    helpers: { level: 'shape', text: 'Zod output for args; wire docs from the db' },
    zodvex: { level: 'codec', text: 'Runtime types everywhere: Date, branded IDs, your codecs' },
  },
  {
    boundary: 'Database writes',
    convex: { level: 'shape', text: "Convex's schema check" },
    helpers: { level: 'shape', text: 'Same as Convex' },
    zodvex: { level: 'codec', text: "Encoded through your schema, then Convex's check" },
  },
  {
    boundary: 'Database reads',
    convex: { level: 'none', text: 'Rows exactly as stored' },
    helpers: { level: 'none', text: 'Rows exactly as stored' },
    zodvex: { level: 'codec', text: 'Every row parsed and decoded through your model' },
  },
  {
    boundary: 'Return value',
    convex: { level: 'shape', text: 'Structural check' },
    helpers: { level: 'zod', text: 'Full Zod pipeline' },
    zodvex: { level: 'codec', text: 'Full Zod pipeline + codec encode' },
  },
  {
    boundary: 'Row rules & audit',
    convex: { level: 'none', text: 'Build your own' },
    helpers: { level: 'shape', text: 'rowLevelSecurity, on wire docs' },
    zodvex: { level: 'codec', text: '.withRules() / .audit() on decoded docs' },
  },
]

const levelLabel: Record<Level, string> = {
  none: 'nothing',
  shape: 'structural',
  zod: 'Zod',
  codec: 'Zod + codecs',
}

const quickstartModels = `// convex/models.ts
import { z } from 'zod'
import { zx, defineZodModel } from 'zodvex'

export const EventModel = defineZodModel('events', {
  title: z.string().min(1),
  startDate: zx.date(),
  endDate: zx.date().optional(),
  location: z.string().optional(),
})`

const quickstartWire = `// convex/schema.ts
import { defineZodSchema } from 'zodvex/server'
import { EventModel } from './models'

export default defineZodSchema({ events: EventModel })

// convex/functions.ts
import { initZodvex } from 'zodvex/server'
import {
  query, mutation, action,
  internalQuery, internalMutation, internalAction,
} from './_generated/server'
import schema from './schema'

export const { zq, zm, za, ziq, zim, zia } = initZodvex(schema, {
  query, mutation, action,
  internalQuery, internalMutation, internalAction,
})`

const quickstartFn = `// convex/events.ts
import { z } from 'zod'
import { zx } from 'zodvex'
import { zq, zm } from './functions'
import { EventModel } from './models'

export const list = zq({
  args: {},
  returns: zx.docArray(EventModel),
  handler: (ctx) => ctx.db.query('events').collect(),   // rows arrive with Date fields
})

export const create = zm({
  args: zx.base(EventModel),                            // the model's fields, as args
  returns: zx.id('events'),
  handler: (ctx, args) => ctx.db.insert('events', args), // Dates encoded on write
})`

const features = [
  {
    title: 'Full Zod at every boundary',
    body: 'Refinements, transforms and codecs run on arguments, return values, and every database read and write. Nothing is erased down to a structural check.',
    icon: '⟲',
  },
  {
    title: 'A codec-aware ctx.db',
    body: 'zx.date(), zx.codec() and zx.id() encode on write and decode on read. Handlers see Date objects and branded IDs; Convex stores plain values.',
    icon: '⇄',
  },
  {
    title: 'Rules and audit, built in',
    body: 'Gate reads and writes per row with .withRules(), observe them with .audit(). Both see decoded documents and compose with each other.',
    icon: '🛡',
  },
  {
    title: 'Codegen for the client',
    body: 'zodvex generate emits typed useZodQuery / useZodMutation hooks, a registry, and codec-aware runQuery, runMutation and scheduler calls.',
    icon: '⌘',
  },
  {
    title: 'Composes with the ecosystem',
    body: 'convex-helpers triggers slot underneath via underlyingDb, streams paginate through the same reader, and .withContext() adds auth to every builder.',
    icon: '⧉',
  },
  {
    title: 'zod/mini ready',
    body: 'Built on zod/v4/core, so the same API ships as zodvex/mini for bundle-sensitive apps. Convex’s optional and nullable semantics are preserved exactly.',
    icon: '◐',
  },
]

const guides = [
  ['The zx namespace', 'zx-namespace', 'zx.id(), zx.date(), zx.codec() and the model helpers'],
  ['Builders', 'builders', 'initZodvex, the six builders, composing with triggers'],
  ['Custom context', 'custom-context', '.withContext(), defineContext, onSuccess'],
  ['Rules and audit', 'rules-and-audit', '.withRules() and .audit() on ctx.db'],
  ['Custom codecs', 'custom-codecs', 'zx.codec(), decodeDoc and encodeDoc'],
  ['Date handling', 'date-handling', 'zx.date() end to end'],
  ['Codegen', 'codegen', 'The CLI, the registry, typed hooks'],
  ['Form validation', 'form-validation', 'react-hook-form with your server schemas'],
  ['Streams', 'streams', 'zodvexStream and zodvexMergedStream'],
  ['Polymorphic tables', 'polymorphic-tables', 'Union and discriminated-union tables'],
] as const
---

<Base title={title} description={description}>
  <header class="nav">
    <div class="wrap nav-inner">
      <a class="brand" href="#top" aria-label="zodvex home">
        <svg width="26" height="26" viewBox="0 0 64 64" aria-hidden="true">
          <rect width="64" height="64" rx="14" fill="#14121f"></rect>
          <path d="M17 20h30l-30 24h30" fill="none" stroke="#8b7bff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"></path>
          <circle cx="49" cy="44" r="6" fill="#2dd4bf"></circle>
        </svg>
        <span>zodvex</span>
      </a>
      <nav class="links" aria-label="Sections">
        <a href="#boundaries">Why</a>
        <a href="#compare">Compare</a>
        <a href="#features">Features</a>
        <a href="#start">Get started</a>
        <a href="#docs">Docs</a>
      </nav>
      <div class="nav-actions">
        <a class="icon-link" href={NPM} target="_blank" rel="noopener">npm</a>
        <a class="icon-link" href={GITHUB} target="_blank" rel="noopener">GitHub</a>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode">
          <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
          <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main id="top">
    <!-- ───────────────────────── hero ───────────────────────── -->
    <section class="hero">
      <div class="wrap hero-inner">
        <p class="eyebrow">Zod v4 + Convex</p>
        <h1>
          Zod is your schema.<br />
          <span class="grad">All the way through Convex.</span>
        </h1>
        <p class="lede">
          Define tables, function arguments and return types once as Zod schemas and use them end
          to end. Full Zod runs at every boundary, and <code>Date</code>s, typed IDs and custom
          codecs survive the trip from the database to your React components.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#compare">See the difference</a>
          <a class="btn" href="#start">Get started</a>
          <div class="install" data-copy="npm install zodvex zod convex convex-helpers">
            <code><span class="prompt">$</span> npm install zodvex zod convex convex-helpers</code>
            <button type="button" class="copy" aria-label="Copy install command">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
            </button>
          </div>
        </div>

        <ol class="pipeline" aria-label="Where zodvex runs your schema">
          <li><span class="node">React</span><small>useZodQuery</small></li>
          <li><span class="node">args</span><small>parse + decode</small></li>
          <li><span class="node">handler</span><small>Date, Id&lt;'t'&gt;</small></li>
          <li><span class="node">ctx.db</span><small>encode / decode</small></li>
          <li><span class="node">returns</span><small>parse + encode</small></li>
        </ol>
        <p class="pipeline-caption">One Zod schema, executed at every hop — not just checked for shape at the function edge.</p>
      </div>
    </section>

    <!-- ───────────────────────── boundary map ───────────────────────── -->
    <section class="section" id="boundaries">
      <div class="wrap">
        <p class="eyebrow">Why</p>
        <h2 class="section-title">Where validation actually happens</h2>
        <p class="section-lede">
          Convex's validators check structure at the function edge. Adding
          <code>convex-helpers/zod</code> upgrades that edge to real Zod. zodvex keeps going:
          the database in the middle and the client at the front use the same schema.
        </p>

        <div class="table-scroll">
          <table class="boundaries">
            <thead>
              <tr>
                <th scope="col">Boundary</th>
                <th scope="col">Convex</th>
                <th scope="col">Convex + convex-helpers/zod</th>
                <th scope="col" class="th-zodvex">zodvex</th>
              </tr>
            </thead>
            <tbody>
              {boundaryRows.map((r) => (
                <tr>
                  <th scope="row">{r.boundary}</th>
                  {(['convex', 'helpers', 'zodvex'] as const).map((k) => (
                    <td class:list={[k === 'zodvex' && 'td-zodvex']}>
                      <span class="pill" data-level={r[k].level}>{levelLabel[r[k].level]}</span>
                      <span class="cell-text">{r[k].text}</span>
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="legend">
          <span class="pill" data-level="none">nothing</span>
          <span class="pill" data-level="shape">structural</span>
          <span class="pill" data-level="zod">Zod</span>
          <span class="pill" data-level="codec">Zod + codecs</span>
        </p>
      </div>
    </section>

    <!-- ───────────────────────── compare ───────────────────────── -->
    <section class="section compare" id="compare" data-before="convex">
      <div class="wrap">
        <p class="eyebrow">Side by side</p>
        <h2 class="section-title">The same app, written both ways</h2>
        <p class="section-lede">
          Five everyday tasks. On the left, what you write today; on the right, the same thing
          with zodvex. Highlighted lines are where the work moves from you to the library.
        </p>
      </div>

      <div class="toggle-bar">
        <div class="wrap toggle-inner">
          <div class="seg" role="group" aria-label="Compare against">
            <span class="seg-label">Compare against</span>
            <button type="button" data-set-before="convex" aria-pressed="true">Convex</button>
            <button type="button" data-set-before="helpers" aria-pressed="false">Convex + convex-helpers/zod</button>
          </div>
          <nav class="jump" aria-label="Scenarios">
            {scenarios.map((s, i) => (
              <a href={`#${s.id}`}><span>{String(i + 1).padStart(2, '0')}</span> {s.title}</a>
            ))}
          </nav>
        </div>
      </div>

      <div class="wrap">
        {scenarios.map((s, i) => <Compare scenario={s} index={i} />)}
      </div>
    </section>

    <!-- ───────────────────────── features ───────────────────────── -->
    <section class="section" id="features">
      <div class="wrap">
        <p class="eyebrow">What's in the box</p>
        <h2 class="section-title">The pieces, and how they fit</h2>
        <p class="section-lede">
          Everything hangs off one call to <code>initZodvex</code>. Codecs are opt-in per field;
          schemas without them still get full validation, typed IDs and exact optional / nullable
          mapping.
        </p>
        <div class="features">
          {features.map((f) => (
            <article class="feature">
              <span class="feature-icon" aria-hidden="true">{f.icon}</span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ───────────────────────── get started ───────────────────────── -->
    <section class="section" id="start">
      <div class="wrap">
        <p class="eyebrow">Get started</p>
        <h2 class="section-title">Three files, then just write functions</h2>
        <p class="section-lede">
          Two of them you write once and rarely touch again. The third is where you live.
        </p>

        <div class="steps">
          <div class="step">
            <div class="step-head"><span class="num">1</span><h3>Define your models</h3></div>
            <p>Client-safe, so the same file feeds React forms and types.</p>
            <CodeBlock code={quickstartModels} file="convex/models.ts" />
          </div>
          <div class="step">
            <div class="step-head"><span class="num">2</span><h3>Wire it up once</h3></div>
            <p>Build the Convex schema from your models and get builders with a codec-aware <code>ctx.db</code>.</p>
            <CodeBlock code={quickstartWire} file="convex/schema.ts · convex/functions.ts" />
          </div>
          <div class="step">
            <div class="step-head"><span class="num">3</span><h3>Write functions</h3></div>
            <p>Arguments and returns are Zod. Rows are decoded on the way out and encoded on the way in.</p>
            <CodeBlock code={quickstartFn} file="convex/events.ts" />
          </div>
        </div>

        <div class="start-links">
          <a class="btn btn-primary" href={`${GITHUB}/tree/main/examples/quickstart`} target="_blank" rel="noopener">Runnable quickstart</a>
          <a class="btn" href={`${GITHUB}/tree/main/examples/task-manager`} target="_blank" rel="noopener">Full example with codegen, rules and triggers</a>
        </div>
      </div>
    </section>

    <!-- ───────────────────────── docs ───────────────────────── -->
    <section class="section" id="docs">
      <div class="wrap">
        <p class="eyebrow">Docs</p>
        <h2 class="section-title">Guides</h2>
        <p class="section-lede">
          The reference guides live in the repository today. Each one is short and example-first.
        </p>
        <ul class="guides">
          {guides.map(([name, slug, blurb]) => (
            <li>
              <a href={guide(slug)} target="_blank" rel="noopener">
                <strong>{name}</strong>
                <span>{blurb}</span>
              </a>
            </li>
          ))}
          <li>
            <a href={`${GITHUB}/blob/main/README.md`} target="_blank" rel="noopener">
              <strong>README</strong>
              <span>The full pitch, install, supported types</span>
            </a>
          </li>
          <li>
            <a href={`${GITHUB}/blob/main/MIGRATION.md`} target="_blank" rel="noopener">
              <strong>Migration guide</strong>
              <span>What changed in each release, plus <code>npx zodvex migrate</code></span>
            </a>
          </li>
        </ul>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer-inner">
      <div>
        <strong>zodvex</strong> · MIT · built for the
        <a href="https://www.convex.dev/" target="_blank" rel="noopener">Convex</a> ecosystem.
        Thanks to <a href="https://github.com/get-convex/convex-helpers" target="_blank" rel="noopener">convex-helpers</a> for the early foundations.
      </div>
      <div class="footer-links">
        <a href={GITHUB} target="_blank" rel="noopener">GitHub</a>
        <a href={NPM} target="_blank" rel="noopener">npm</a>
        <a href={`${GITHUB}/blob/main/CHANGELOG.md`} target="_blank" rel="noopener">Changelog</a>
        <a href={`${GITHUB}/blob/main/docs/roadmap.md`} target="_blank" rel="noopener">Roadmap</a>
      </div>
    </div>
  </footer>
</Base>

<script>
  const root = document.documentElement

  // Theme toggle (system by default, persisted once the user picks).
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const sysDark = matchMedia('(prefers-color-scheme: dark)').matches
    const current = root.dataset.theme ?? (sysDark ? 'dark' : 'light')
    const next = current === 'dark' ? 'light' : 'dark'
    root.dataset.theme = next
    try { localStorage.setItem('zodvex-theme', next) } catch {}
  })

  // "Compare against" switch for the before pane.
  const compare = document.getElementById('compare')
  const buttons = compare?.querySelectorAll<HTMLButtonElement>('[data-set-before]') ?? []
  const setBefore = (value: string) => {
    if (!compare) return
    compare.dataset.before = value
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.setBefore === value)))
    try { localStorage.setItem('zodvex-before', value) } catch {}
  }
  buttons.forEach((b) => b.addEventListener('click', () => setBefore(b.dataset.setBefore!)))
  try {
    const saved = localStorage.getItem('zodvex-before')
    if (saved === 'convex' || saved === 'helpers') setBefore(saved)
  } catch {}

  // Copy install command.
  document.querySelectorAll<HTMLElement>('[data-copy]').forEach((el) => {
    const btn = el.querySelector('button')
    btn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(el.dataset.copy ?? '')
        el.classList.add('copied')
        setTimeout(() => el.classList.remove('copied'), 1400)
      } catch {}
    })
  })
</script>

<style>
  /* nav */
  .nav {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    backdrop-filter: saturate(160%) blur(12px);
    -webkit-backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner { display: flex; align-items: center; gap: 1.5rem; height: 3.75rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; font-weight: 700; font-size: 1.1rem; letter-spacing: -0.01em; }
  .brand svg { border-radius: 7px; }
  .links { display: flex; gap: 1.25rem; margin-left: auto; font-size: 0.93rem; color: var(--fg-2); }
  .links a:hover { color: var(--fg); }
  .nav-actions { display: flex; align-items: center; gap: 0.75rem; }
  .icon-link { font-size: 0.9rem; font-weight: 500; color: var(--fg-2); }
  .icon-link:hover { color: var(--fg); }
  .theme-toggle {
    display: inline-grid; place-items: center;
    width: 2.1rem; height: 2.1rem;
    border-radius: 8px; border: 1px solid var(--line-strong);
    background: var(--bg-2); color: var(--fg); cursor: pointer;
  }
  .theme-toggle .moon { display: none; }
  :global(html[data-theme='dark']) .theme-toggle .sun { display: none; }
  :global(html[data-theme='dark']) .theme-toggle .moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .theme-toggle .sun { display: none; }
    :global(html:not([data-theme='light'])) .theme-toggle .moon { display: block; }
  }
  @media (max-width: 760px) {
    .links { display: none; }
    .nav-actions { margin-left: auto; }
  }

  /* hero */
  .hero {
    position: relative;
    padding: clamp(4rem, 10vw, 7.5rem) 0 clamp(3rem, 6vw, 5rem);
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute; inset: -20% -10% auto;
    height: 70%;
    background:
      radial-gradient(600px 300px at 20% 20%, color-mix(in oklab, var(--accent) 22%, transparent), transparent 70%),
      radial-gradient(500px 260px at 80% 10%, color-mix(in oklab, var(--good) 16%, transparent), transparent 70%);
    pointer-events: none;
    filter: blur(10px);
  }
  .hero-inner { position: relative; }
  h1 {
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    margin: 0 0 1.25rem;
    max-width: 16ch;
    letter-spacing: -0.035em;
  }
  .grad {
    background: linear-gradient(90deg, var(--accent), var(--good));
    -webkit-background-clip: text; background-clip: text;
    color: transparent;
  }
  .lede { font-size: clamp(1.05rem, 1.6vw, 1.25rem); color: var(--fg-2); max-width: 64ch; margin: 0 0 1.75rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
  .install {
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.55rem 0.6rem 0.55rem 0.9rem;
    border: 1px solid var(--line-strong); border-radius: 10px;
    background: var(--code-bg);
    font-size: 0.86rem;
    max-width: 100%;
  }
  .install code { white-space: nowrap; overflow-x: auto; }
  .install .prompt { color: var(--accent); margin-right: 0.4rem; }
  .copy {
    display: inline-grid; place-items: center;
    width: 1.9rem; height: 1.9rem; border-radius: 7px;
    border: 1px solid var(--line); background: var(--bg-2); color: var(--fg-2); cursor: pointer;
  }
  .copy:hover { color: var(--fg); border-color: var(--accent); }
  .install.copied .copy { color: var(--good); border-color: var(--good); }

  .pipeline {
    list-style: none; padding: 0;
    margin: 3rem 0 0.75rem;
    display: flex; flex-wrap: wrap; gap: 0.75rem 0;
    align-items: stretch;
  }
  .pipeline li {
    position: relative;
    display: flex; flex-direction: column; align-items: center; gap: 0.35rem;
    flex: 1 1 130px;
    padding: 0 0.5rem;
  }
  .pipeline li + li::before {
    content: '';
    position: absolute; left: -0.6rem; top: 1.05rem;
    width: 1.2rem; height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--good));
    opacity: 0.7;
  }
  .node {
    font: 600 0.82rem/1 var(--font-mono);
