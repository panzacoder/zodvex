{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "capacity/**/*.ts",
    "consumer-dynamic-import/shape.ts",
    "consumer-dynamic-import/operation.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
